# PostgreSQL settings used by Docker Compose.
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura

# Backend settings. Use db as the hostname inside Docker Compose and localhost locally.
DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura
CORS_ORIGINS=["http://localhost:5173"]
# Native and otherwise unvalidated runtimes are read-only. Docker Compose overrides
# these values with its validated Docker-managed /workspace volume.
WORKSPACE_ROOT=../workspace
WORKSPACE_WRITE_MODE=read_only

# Planner settings. mock is deterministic and requires no external credentials.
PLANNER_BACKEND=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_PROVIDER_TIMEOUT_SECONDS=20
AI_PROVIDER_MAX_OUTPUT_TOKENS=512

# Frontend settings.
VITE_API_BASE_URL=http://localhost:8000/api
