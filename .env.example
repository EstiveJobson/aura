# PostgreSQL settings used by Docker Compose.
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura

# Backend settings. Use db as the hostname inside Docker Compose and localhost locally.
DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura
CORS_ORIGINS=["http://localhost:5173"]
WORKSPACE_ROOT=.

# Frontend settings.
VITE_API_BASE_URL=http://localhost:8000/api
